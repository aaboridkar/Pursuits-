{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src", "shared"],
  // The IBP-specific domain components below came with the design system and
  // depend on IBP data modules that are not part of this app. They are kept
  // as reference material but excluded from the build.
  "exclude": [
    "src/components/domain/ActionTable.tsx",
    "src/components/domain/AgendaList.tsx",
    "src/components/domain/ArtifactList.tsx",
    "src/components/domain/AttributionBar.tsx",
    "src/components/domain/ConstraintChain.tsx",
    "src/components/domain/CycleHistoryStrip.tsx",
    "src/components/domain/CycleSelector.tsx",
    "src/components/domain/DecisionGroup.tsx",
    "src/components/domain/DecisionTable.tsx",
    "src/components/domain/DomainChip.tsx",
    "src/components/domain/domainMeta.ts",
    "src/components/domain/EvidenceGrid.tsx",
    "src/components/domain/FacilitatorPanel.tsx",
    "src/components/domain/IssueTable.tsx",
    "src/components/domain/MeetingHeader.tsx",
    "src/components/domain/PriorityInbox.tsx",
    "src/components/domain/ReviewPipeline.tsx",
    "src/components/domain/StatusBadges.tsx",
    "src/components/domain/Stepper.tsx",
    "src/components/domain/TranscriptFeed.tsx"
  ]
}
