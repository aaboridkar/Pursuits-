# Pursuits settings. Copy this file to ".env" in the same folder and fill in the values.
# .env is never committed to git — keep passwords only there (or in the App Service / VM settings).
# A value already set in the environment (App Service application settings, the VM's service file) wins over .env.

# ─── Database: Azure SQL ──────────────────────────────────────────────────────────────────────────────────────────
# Set AZURE_SQL_SERVER to use Azure SQL. Leave it empty (commented out) to use the local SQLite file instead.
AZURE_SQL_SERVER=supply-chain-capability-dev-supplychaindev-mssql-server.database.windows.net
AZURE_SQL_DATABASE=supply-chain-capability-dev-supplychaindev-mssql-db
# The schema created by deploy/azure-sql/01-create-tables.sql
AZURE_SQL_SCHEMA=AIT_SC_Gov

# How to sign in to Azure SQL:
#   entra = Microsoft Entra ID, no password stored. Uses the App Service / VM managed identity, or `az login` on a laptop.
#           That identity needs a database user:  CREATE USER [<app or VM name>] FROM EXTERNAL PROVIDER;
#                                                 ALTER ROLE db_datareader ADD MEMBER [<app or VM name>];
#                                                 ALTER ROLE db_datawriter ADD MEMBER [<app or VM name>];
#   sql   = a SQL login: fill in AZURE_SQL_USER and AZURE_SQL_PASSWORD.
AZURE_SQL_AUTH=sql
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
# Entra only, optional: client id of a user-assigned managed identity.
# AZURE_SQL_CLIENT_ID=

# ─── Server ───────────────────────────────────────────────────────────────────────────────────────────────────────
PORT=4100
# Behind App Service or another proxy: log each visitor's real address (1) — leave 0 when people connect directly.
TRUST_PROXY=0

# ─── Only for the "App Service in front of a VM" setup (see README) ─────────────────────────────────────────────
# On App Service:  API_UPSTREAM=http://<vm-address>:4100   (the screens then fetch data from that server)
# API_UPSTREAM=
# On both sides, the same secret:
# GATEWAY_KEY=

# ─── Only when NOT using Azure SQL ────────────────────────────────────────────────────────────────────────────────
# PURSUITS_DB=data/pursuits.db
